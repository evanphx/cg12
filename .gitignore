# Core dumps. qemu names its own qemu_<prog>_<timestamp>_<pid>.core, which
# neither of the first two patterns matches -- four of them were committed
# before the third was added.
core
core.*
*.core
# ...but Go source files named core.go are not core dumps.
!core.go

# Test / build binaries
*.o
*.a
*.out
*.exe
*.test

# Default command outputs used by repository demos
/hello
/runtime_assembly
/cmd/cc/prog

# ...but .out files under testdata are expected-output fixtures, not build output
!**/testdata/**/*.out

# Editor / OS cruft
*~
.DS_Store

# build artifacts from analysis tools
/splitdiff

# Build artifacts left by corpus runs
runtime_closure_captured_string
pkginit_dispatch
runtime_package_initializer_dispatch

# goc-built corpus binaries. `go run ./cmd/goc -run` and the corpus harnesses
# drop an executable named after the program in the working directory; four have
# been committed by accident. These have no extension, so match them by name.
/allocation_counts
/pkginit_dispatch
/runtime_package_initializer_dispatch
/runtime_closure_captured_string
/recv2
/growcost
/main

# Python bytecode from the placement sweep helper
__pycache__/
*.pyc
